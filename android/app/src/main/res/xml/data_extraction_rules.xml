<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API level 31+) data extraction rules for ASTRA -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Include SQLite databases and critical shared preferences -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <!-- Exclude temporary caches, compiled code caches, and asset directories -->
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="tmp" />
        <exclude domain="file" path="flutter_assets" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Include database and preferences during device-to-device migration -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude domain="root" path="cache" />
        <exclude domain="root" path="code_cache" />
        <exclude domain="root" path="tmp" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
