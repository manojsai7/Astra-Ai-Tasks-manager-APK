<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 (API level < 31) full backup content rules for ASTRA -->
<full-backup-content>
    <!-- Include persistent databases and preferences -->
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <!-- Exclude temporary caches and large assets -->
    <exclude domain="root" path="cache" />
    <exclude domain="root" path="code_cache" />
    <exclude domain="root" path="tmp" />
    <exclude domain="file" path="flutter_assets" />
    <exclude domain="external" path="." />
</full-backup-content>
